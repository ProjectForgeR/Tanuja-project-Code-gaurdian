# CodeGuardian AI Environment Configuration

PROJECT_NAME=CodeGuardian AI
VERSION=1.0.0
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database:
# For Local Development (default SQLite):
# DATABASE_URL=sqlite+aiosqlite:///./codeguardian.db
#
# For Real PostgreSQL / Supabase (Paste your actual connection string here):
# DATABASE_URL=postgresql+asyncpg://postgres:[YOUR_PASSWORD]@[YOUR_HOST]:5432/postgres
# Or Supabase Pooler (Transaction Mode, port 6543):
# DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite+aiosqlite:///./codeguardian.db

# Optional AI Providers (Leave blank for deterministic static analysis mode)
GEMINI_API_KEY=
OPENAI_API_KEY=
DEFAULT_AI_PROVIDER=gemini
DEFAULT_AI_MODEL=gemini-1.5-pro

# Request Limits
MAX_CODE_SIZE_BYTES=1048576
ANALYSIS_TIMEOUT_SECONDS=30
