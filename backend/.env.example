# CodeGuardian AI Backend Environment Configuration

PROJECT_NAME=CodeGuardian AI
VERSION=1.0.0
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
DATABASE_URL=sqlite+aiosqlite:///./codeguardian.db

# Optional AI Providers
GEMINI_API_KEY=
OPENAI_API_KEY=
DEFAULT_AI_PROVIDER=gemini
DEFAULT_AI_MODEL=gemini-1.5-pro

# Limits
MAX_CODE_SIZE_BYTES=1048576
ANALYSIS_TIMEOUT_SECONDS=30
