# CodeGuardian AI Backend Environment Configuration

PROJECT_NAME=CodeGuardian AI
VERSION=1.0.0
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
DATABASE_URL=sqlite+aiosqlite:///./codeguardian.db

# AI Providers (Groq recommended for high-speed diagnostic & fix synthesis)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
DEFAULT_AI_PROVIDER=groq
GEMINI_API_KEY=
OPENAI_API_KEY=
DEFAULT_AI_MODEL=llama-3.3-70b-versatile


# Limits
MAX_CODE_SIZE_BYTES=1048576
ANALYSIS_TIMEOUT_SECONDS=30
